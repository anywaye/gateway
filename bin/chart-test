#!/usr/bin/env bash

set -euo pipefail

cd "$(dirname "$0")/.."

CHART=charts/gateway
failures=0

note() { printf '\n== %s\n' "$*"; }
ok()   { printf 'ok   - %s\n' "$*"; }
bad()  { printf 'FAIL - %s\n' "$*"; failures=$((failures + 1)); }

assert() {
  if printf '%s' "$3" | grep -qF -- "$2"; then
    ok "$1"
  else
    bad "$1 — wanted: $2"
  fi
}

assert_absent() {
  if printf '%s' "$3" | grep -qF -- "$2"; then
    bad "$1 — unwanted: $2"
  else
    ok "$1"
  fi
}

ingress_doc() {
  helm template gateway "$CHART" "$@" 2>&1 | awk '
    /^
    f && /^---$/ { exit }
    f { print }
  '
}

deployment_doc() {
  helm template gateway "$CHART" "$@" 2>&1 | awk '
    /^
    f && /^---$/ { exit }
    f { print }
  '
}

note "1. committed values — the Ingress carries the issuer annotation (B7)"
doc=$(ingress_doc)
if [ -z "$doc" ]; then
  bad "helm template renders the Ingress with the committed values — it did not"
else
  ok "helm template renders the Ingress with the committed values"
fi
assert "cert-manager.io/cluster-issuer: letsencrypt-prod is set" \
  "cert-manager.io/cluster-issuer: letsencrypt-prod" "$doc"
assert "tls.secretName: gateway-tls is unchanged" \
  "secretName: gateway-tls" "$doc"

note "2. the control that must go red — empty issuer: annotation absent, Ingress still renders"
doc=$(ingress_doc --set ingress.clusterIssuer="")
if [ -z "$doc" ]; then
  bad "the Ingress still renders with an empty issuer — it did not"
else
  ok "the Ingress still renders with an empty issuer"
fi
assert_absent "cert-manager.io/cluster-issuer is absent" \
  "cert-manager.io/cluster-issuer" "$doc"
assert "tls.secretName: gateway-tls is still set" \
  "secretName: gateway-tls" "$doc"

note "3. the operator annotations map still works, and does not collide"
doc=$(ingress_doc --set 'ingress.annotations.foo=bar')
assert "operator annotation foo: bar renders" \
  "foo: bar" "$doc"
assert "the issuer annotation renders beside it" \
  "cert-manager.io/cluster-issuer: letsencrypt-prod" "$doc"

override=$(mktemp)
trap 'rm -f "$override"' EXIT
cat > "$override" <<'EOF'
ingress:
  annotations:
    cert-manager.io/cluster-issuer: letsencrypt-staging
EOF
doc=$(ingress_doc -f "$override")
assert "an explicit operator issuer wins" \
  "cert-manager.io/cluster-issuer: letsencrypt-staging" "$doc"
assert_absent "the value-derived issuer does not duplicate it" \
  "cert-manager.io/cluster-issuer: letsencrypt-prod" "$doc"

note "4. the Deployment pulls the published image — by digest, or by tag"
module_path="$(sed -n 's/^module[[:space:]]\{1,\}\([^[:space:]]*\).*/\1/p' go.mod | head -n1)"
published="ghcr.io/${module_path#github.com/}"
app_version="$(sed -n 's/^appVersion:[[:space:]]*//p' "$CHART/Chart.yaml" | head -n1 | tr -d "\"'")"
image_digest="$(sed -n 's/^  digest:[[:space:]]*//p' "$CHART/values.yaml" | head -n1 | tr -d "\"'")"

doc=$(deployment_doc)
if [ -z "$doc" ]; then
  bad "helm template renders the Deployment — it did not"
else
  ok "helm template renders the Deployment"
fi

if [ -z "$image_digest" ]; then
  bad "values.yaml names no image.digest — the Deployment would render '$published@', a reference no registry answers"
  image_digest="sha256:$(printf '%064d' 0)"
else
  ok "values.yaml names image.digest $image_digest"
fi
assert "the container image is the published repository at the committed digest" \
  "image: \"$published@$image_digest\"" "$doc"
assert_absent "the container image is NOT named by the mutable tag" \
  "image: \"$published:$app_version\"" "$doc"

changed="sha256:$(printf '%064d' 1)"
doc=$(deployment_doc --set image.digest="$changed")
assert "a changed digest changes the rendered image (the diff Argo reads)" \
  "image: \"$published@$changed\"" "$doc"
assert_absent "the committed digest is gone from the changed render" \
  "image: \"$published@$image_digest\"" "$doc"

doc=$(deployment_doc --set image.repository=anywaye/gateway)
assert "the control renders a hostless repository at the digest" \
  "image: \"anywaye/gateway@$image_digest\"" "$doc"
assert_absent "the control does not render the published path" \
  "image: \"$published@" "$doc"

doc=$(deployment_doc --set image.digest="")
assert "no digest falls back to the committed tag" \
  "image: \"$published:$app_version\"" "$doc"
assert_absent "no digest does NOT render a bare 'repository@'" \
  "image: \"$published@\"" "$doc"

for shape in not-a-digest sha256:abc "sha256:$(printf '%063d' 0)z"; do
  if helm template gateway "$CHART" --set "image.digest=$shape" >/dev/null 2>&1; then
    bad "a malformed digest is refused — '$shape' rendered instead"
  else
    ok "a malformed digest is refused: $shape"
  fi
  err="$(helm template gateway "$CHART" --set "image.digest=$shape" 2>&1 || true)"
  assert "the refusal for '$shape' names image.digest" "image.digest" "$err"
done

note "5. helm lint"
if helm lint "$CHART" >/dev/null 2>&1; then
  ok "helm lint passes"
else
  bad "helm lint failed"
fi

printf '\n'
if [ "$failures" -gt 0 ]; then
  printf '== chart test: %d failure(s)\n' "$failures"
  exit 1
fi
printf '== chart test ok\n'
