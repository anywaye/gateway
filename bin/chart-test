#!/usr/bin/env bash
#
# bin/chart-test — gateway's chart test.
#
#   ./bin/chart-test   render charts/gateway with helm and assert the Ingress
#                      carries the cert-manager issuer annotation
#
# WHAT IT IS: the bounded chart check W67 recorded by hand in
# REPORT-gateway-chart-01.md ("The render, recorded exactly") and this packet
# makes continuous. It is deliberately NOT wired into bin/prime: the gate is
# static Go with a port-probe test, and a chart test needs `helm` on the
# machine — the manager owns the gate and W67's report ruled the render "a
# separate, bounded command" rather than part of it.
#
# WHAT IT ASSERTS:
#   1. `helm template` with the committed values renders the Ingress with
#      `cert-manager.io/cluster-issuer: letsencrypt-prod` and the existing
#      `tls.secretName: gateway-tls`. Before packet gateway-w94-issuer the
#      annotation was nowhere in the chart, so `gateway-tls` was a secret
#      nothing filled and TLS failed on the box — launch item B7.
#   2. THE CONTROL THAT MUST GO RED: with `ingress.clusterIssuer: ""` the
#      annotation is ABSENT — the chart does not invent an issuer — and the
#      Ingress still renders. Empty means no cert-manager: a secret nothing
#      writes (the generator's own rule, caf/internal/gen/chart.go).
#   3. The operator's `ingress.annotations` map still works and does not
#      collide with the issuer: operator annotations render beside it, and an
#      explicit operator `cert-manager.io/cluster-issuer` wins over the value
#      (a duplicate key is invalid YAML, so one of them must).
#   4. THE DEPLOYMENT PULLS THE PUBLISHED IMAGE, NAMED BY DIGEST. The rendered
#      container image is `<published>@<digest>` — the digest read from the
#      same values.yaml the Deployment renders — and a CHANGED digest changes
#      the rendered text, which is the property Argo's diff reads. The
#      measured defect this replaced: the chart pinned the image by TAG
#      (`repository:tag`), the tag is overwritten on every master push, so the
#      rendered string was identical before and after a build, Argo reported
#      `Synced` with no rollout, and `imagePullPolicy: IfNotPresent` kept the
#      node on the six-hour-old image (REPORT-roll-c5-image-digest.md carries
#      the two digests). THE RED CONTROL: an empty or malformed digest renders
#      a reference no registry answers (`repository@`, `repository@nonsense`),
#      and a values.yaml with NO digest is refused HERE before anything
#      asserts on it — an assertion would otherwise match the broken render
#      with an empty digest, which is exactly how a check passes because the
#      field is absent. The same absence and malformation are refused by
#      `bin/prime-go` statically, the way the host check above is.
#   5. `helm lint` passes.
#
# set -euo pipefail is the whole mechanism — no error handling to forget.

set -euo pipefail

cd "$(dirname "$0")/.."

CHART=charts/gateway
failures=0

note() { printf '\n== %s\n' "$*"; }
ok()   { printf 'ok   - %s\n' "$*"; }
bad()  { printf 'FAIL - %s\n' "$*"; failures=$((failures + 1)); }

# assert <description> <fixed string wanted> <haystack>
assert() {
  if printf '%s' "$3" | grep -qF -- "$2"; then
    ok "$1"
  else
    bad "$1 — wanted: $2"
  fi
}

# assert_absent <description> <fixed string unwanted> <haystack>
assert_absent() {
  if printf '%s' "$3" | grep -qF -- "$2"; then
    bad "$1 — unwanted: $2"
  else
    ok "$1"
  fi
}

# ingress_doc [helm args...] — the rendered Ingress document, extracted from
# a full render: from the ingress source comment to the next document
# separator. Empty means the Ingress did not render at all.
ingress_doc() {
  helm template gateway "$CHART" "$@" 2>&1 | awk '
    /^# Source: gateway\/templates\/ingress\.yaml$/ { f=1 }
    f && /^---$/ { exit }
    f { print }
  '
}

# deployment_doc [helm args...] — the rendered Deployment document, same shape.
deployment_doc() {
  helm template gateway "$CHART" "$@" 2>&1 | awk '
    /^# Source: gateway\/templates\/deployment\.yaml$/ { f=1 }
    f && /^---$/ { exit }
    f { print }
  '
}

note "1. committed values — the Ingress carries the issuer annotation (B7)"
doc=$(ingress_doc)
if [ -z "$doc" ]; then
  bad "helm template renders the Ingress with the committed values — it did not"
else
  ok "helm template renders the Ingress with the committed values"
fi
assert "cert-manager.io/cluster-issuer: letsencrypt-prod is set" \
  "cert-manager.io/cluster-issuer: letsencrypt-prod" "$doc"
assert "tls.secretName: gateway-tls is unchanged" \
  "secretName: gateway-tls" "$doc"

note "2. the control that must go red — empty issuer: annotation absent, Ingress still renders"
doc=$(ingress_doc --set ingress.clusterIssuer="")
if [ -z "$doc" ]; then
  bad "the Ingress still renders with an empty issuer — it did not"
else
  ok "the Ingress still renders with an empty issuer"
fi
assert_absent "cert-manager.io/cluster-issuer is absent" \
  "cert-manager.io/cluster-issuer" "$doc"
assert "tls.secretName: gateway-tls is still set" \
  "secretName: gateway-tls" "$doc"

note "3. the operator annotations map still works, and does not collide"
doc=$(ingress_doc --set 'ingress.annotations.foo=bar')
assert "operator annotation foo: bar renders" \
  "foo: bar" "$doc"
assert "the issuer annotation renders beside it" \
  "cert-manager.io/cluster-issuer: letsencrypt-prod" "$doc"

# An operator who sets the issuer key explicitly in the map wins: a duplicate
# annotation key is invalid YAML, so the value-derived one must stand down.
# A values file rather than --set, because --set reads the dots in
# `cert-manager.io/cluster-issuer` as nesting separators.
override=$(mktemp)
trap 'rm -f "$override"' EXIT
cat > "$override" <<'EOF'
ingress:
  annotations:
    cert-manager.io/cluster-issuer: letsencrypt-staging
EOF
doc=$(ingress_doc -f "$override")
assert "an explicit operator issuer wins" \
  "cert-manager.io/cluster-issuer: letsencrypt-staging" "$doc"
assert_absent "the value-derived issuer does not duplicate it" \
  "cert-manager.io/cluster-issuer: letsencrypt-prod" "$doc"

note "4. the Deployment pulls the image the publish loop pushes, NAMED BY DIGEST"
# DERIVED, not typed: kit's image workflow pushes to ghcr.io/<github.repository>
# and takes no input for the name, so the expected path comes from this
# repository's own go.mod module path. A hostless value is the measured failure.
module_path="$(sed -n 's/^module[[:space:]]\{1,\}\([^[:space:]]*\).*/\1/p' go.mod | head -n1)"
published="ghcr.io/${module_path#github.com/}"
app_version="$(sed -n 's/^appVersion:[[:space:]]*//p' "$CHART/Chart.yaml" | head -n1 | tr -d "\"'")"
# The digest, READ from the same values.yaml the Deployment renders: a check
# that typed its own digest would be a copy of the value, not a reading of it.
image_digest="$(sed -n 's/^  digest:[[:space:]]*//p' "$CHART/values.yaml" | head -n1 | tr -d "\"'")"

doc=$(deployment_doc)
if [ -z "$doc" ]; then
  bad "helm template renders the Deployment — it did not"
else
  ok "helm template renders the Deployment"
fi

# THE ABSENCE IS THE FAILURE, NAMED FIRST. With an empty digest the assertion
# below would MATCH the broken render — `image: "$published@"` — and a check
# that passes because the field is absent is worse than no check. So the
# absence is refused here, at the render level, and statically in bin/prime-go.
if [ -z "$image_digest" ]; then
  bad "values.yaml names no image.digest — the Deployment would render '$published@', a reference no registry answers"
  image_digest="sha256:$(printf '%064d' 0)"
else
  ok "values.yaml names image.digest $image_digest"
fi
assert "the container image is the published repository at the committed digest" \
  "image: \"$published@$image_digest\"" "$doc"
assert_absent "the container image is NOT named by the mutable tag" \
  "image: \"$published:$app_version\"" "$doc"

# THE CASE ARGO'S DIFF READS: a changed digest is a changed Deployment. The
# tag was identical before and after a build, which is why the diff never
# fired and the box never rolled; this is the property the packet buys.
changed="sha256:$(printf '%064d' 1)"
doc=$(deployment_doc --set image.digest="$changed")
assert "a changed digest changes the rendered image (the diff Argo reads)" \
  "image: \"$published@$changed\"" "$doc"
assert_absent "the committed digest is gone from the changed render" \
  "image: \"$published@$image_digest\"" "$doc"

# The control: a hostless repository renders Docker Hub-shaped, which is what
# the box measured, and the published path is absent — so the assertion above
# is about the value and not about a string that happens to appear.
doc=$(deployment_doc --set image.repository=cafaye/gateway)
assert "the control renders a hostless repository at the digest" \
  "image: \"cafaye/gateway@$image_digest\"" "$doc"
assert_absent "the control does not render the published path" \
  "image: \"$published@" "$doc"

# THE RED CONTROL, at the render level: an empty or malformed digest renders a
# reference no registry answers. The template cannot refuse a value it is
# handed — that refusal is bin/prime-go's static check, and this is the half
# that shows what the refusal is about: a chart that would render these
# shapes is a pod in image-pull failure with nothing naming the field.
doc=$(deployment_doc --set image.digest="")
assert "an empty digest renders the broken reference 'repository@'" \
  "image: \"$published@\"" "$doc"
doc=$(deployment_doc --set image.digest="not-a-digest")
assert "a malformed digest renders exactly what it was given" \
  "image: \"$published@not-a-digest\"" "$doc"

note "5. helm lint"
if helm lint "$CHART" >/dev/null 2>&1; then
  ok "helm lint passes"
else
  bad "helm lint failed"
fi

printf '\n'
if [ "$failures" -gt 0 ]; then
  printf '== chart test: %d failure(s)\n' "$failures"
  exit 1
fi
printf '== chart test ok\n'
