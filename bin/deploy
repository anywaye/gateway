#!/usr/bin/env bash
set -euo pipefail

SERVICE="$(basename "$(cd "$(dirname "$0")/.." && pwd)")"
RESTART=1
PUBLISH_ARGS=()
for a in "$@"; do
  case "$a" in
    --no-restart) RESTART=0 ;;
    *) PUBLISH_ARGS+=("$a") ;;
  esac
done

if [ -x ./bin/migrate ]; then
  echo "deploy: running migrations for $SERVICE"
  export DATABASE_URL="postgres://$SERVICE:anywaye@localhost:15500/$SERVICE?sslmode=disable"
  export SHIP_DATABASE_URL="$DATABASE_URL"
  if ./bin/migrate; then
    echo "deploy: migrations applied for $SERVICE"
  else
    echo "deploy: WARN — migrations failed or already applied for $SERVICE; continuing (apply by hand if needed)" >&2
  fi
else
  echo "deploy: no bin/migrate for $SERVICE — skipping migrations"
fi

echo "deploy: publishing $SERVICE"
./bin/publish "${PUBLISH_ARGS[@]}"

VERSION="$(grep '^version:' chart/Chart.yaml | awk '{print $2}')"
if [ -f deploy/argocd-application.yaml ]; then
  sed -i "s/targetRevision:.*/targetRevision: $VERSION/" deploy/argocd-application.yaml
  echo "deploy: bumped targetRevision to $VERSION in deploy/argocd-application.yaml"
fi

if [ "$RESTART" -eq 1 ]; then
  echo "deploy: committing version bump to Git"
  git add -A 2>/dev/null || true
  git commit -m "deploy: $SERVICE $VERSION" 2>/dev/null || echo "deploy: nothing to commit (already up to date)"
  git push origin master 2>&1 | tail -3
  echo "deploy: pushed to master — Argo CD will sync on webhook"
fi

if [ "$RESTART" -eq 1 ] && [ -d /data/workspace ]; then
  echo "deploy: restarting $SERVICE on the box"
  case "$SERVICE" in
    ship)
      pkill -f "/data/workspace/ship/ship" 2>/dev/null || true
      sleep 1
      cd /data/workspace/ship
      SHIP_DATABASE_URL="postgres://ship:anywaye@localhost:15500/ship?sslmode=disable" \
      SHIP_TOKEN="dev-token" SHIP_HTTP_ADDR=":8090" \
      nohup /data/workspace/ship/ship > /tmp/ship.log 2>&1 &
      echo "ship restarted (pid $!)"
      ;;
    gateway)
      pkill -f "cmd/gateway" 2>/dev/null || true
      sleep 1
      cd /data/workspace/gateway
      PORT=8081 IDENTITY_URL=http://localhost:8080 \
      nohup go run ./cmd/gateway > /tmp/gateway.log 2>&1 &
      echo "gateway restarted (pid $!)"
      ;;
    identity)
      echo "identity: restart via bin/dev / identity compose (not auto-restarted here)"
      ;;
    website)
      echo "website: vite dev server auto-reloads on source change; no restart needed"
      ;;
    ella)
      echo "ella: restart uvicorn manually or via start-dev-services.sh"
      ;;
    *)
      echo "$SERVICE: no auto-restart rule; restart manually"
      ;;
  esac
fi

echo "deploy: done — Argo CD syncs on Git push for $SERVICE"
