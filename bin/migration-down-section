#!/usr/bin/env bash

set -uo pipefail

if [ "$#" -ne 1 ]; then
  echo "usage: bin/migration-down-section <migration.sql>" >&2
  exit 2
fi

migration="$1"
if [ ! -r "$migration" ]; then
  echo "bin/migration-down-section: $migration is not readable" >&2
  exit 2
fi

awk 'found { print } /^--[[:space:]]*\+goose[[:space:]]+Down/ { found=1 }' "$migration"
