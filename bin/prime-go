#!/usr/bin/env bash
# bin/prime-go — the Go tier of gateway's gate, and since the cutover the WHOLE
# of it.
#
#   ./bin/prime-go   gofmt, build, vet, test, generated-code currency
#
# WHY A SECOND SCRIPT rather than more steps in bin/prime. It used to be two
# tiers: `bin/prime` ran the TypeScript tier and called this last, and the two
# coexisted for the length of the rewrite. `src/` is gone — deleted at cutover
# (f87c891) once equivalence was proven: 51 cases, 13 scenarios, 914
# comparisons, 0 differences — so `bin/prime` is now a wrapper around this file
# and this file is the gate. It is still separate because `gate.yml` declares
# `entrypoint: bin/prime`, and because "which tier is red" should stay a
# question with an answer even when there is one tier.
#
# Green on a bare machine with a Go toolchain on PATH and no network. The live
# Redis tier skips unless `GATEWAY_REDIS_URL` is set, prints a COUNTED SKIP
# naming the reason rather than reporting a green that verified nothing, and is
# counted below.
set -euo pipefail
set -o pipefail

cd "$(dirname "$0")/.."

step() { printf '\n\033[1m==> %s\033[0m\n' "$1"; }

# THE TOOLCHAIN ASSERTION, and it is this script's first step and its only
# precondition: this repository pins a Go version in TWO files (mise.toml's `go`
# and the Dockerfile's ARG GO_VERSION), and nothing makes the go command
# enforce either. Without the check a developer on a newer Go silently produces a
# binary CI never built, and reads the difference as a defect in the code under
# test — the cafaye-rb lesson, in a second language.
if ! command -v go >/dev/null 2>&1; then
  echo "bin/prime-go: go is not on PATH — run 'mise install' in this worktree" >&2
  exit 127
fi

pinned_go="$(sed -n 's/^go *= *"\(.*\)"/\1/p' mise.toml)"
if [ -z "$pinned_go" ]; then
  echo "bin/prime-go: mise.toml pins no go toolchain, so this gate cannot check the" >&2
  echo "  toolchain it is about to run. Either restore the pin or stop claiming one." >&2
  exit 127
fi

# go.mod's own `go` directive is the third copy of the number, and it is the one
# the compiler enforces. A go.mod newer than the pin means somebody raised the
# language version without raising the pin, and the error that produces is a
# wall of text about language features.
mod_go="$(sed -n 's/^go *\([0-9][0-9.]*\).*/\1/p' go.mod)"
if [ -n "$mod_go" ] && [ "$mod_go" != "$pinned_go" ]; then
  echo "bin/prime-go: go.mod declares go $mod_go and mise.toml pins $pinned_go." >&2
  echo "  One language version, two files (go.mod, mise.toml) plus the ARG" >&2
  echo "  GO_VERSION in the Dockerfile that names the image tag. Fix whichever is" >&2
  echo "  wrong rather than the one you read first." >&2
  exit 127
fi

actual_go="$(go version | awk '{print $3}' | sed 's/^go//')"
if [ "$actual_go" != "$pinned_go" ] && [ "${actual_go#"$pinned_go."}" = "$actual_go" ]; then
  echo "bin/prime-go: go is $actual_go, and mise.toml pins $pinned_go." >&2
  echo "  Run 'mise install' in this worktree. Continuing would report compiler" >&2
  echo "  errors about language features as if they were defects in the code." >&2
  exit 127
fi

step "toolchain: go $actual_go (mise.toml pins $pinned_go)"
go version

# THE IMAGE TAG AGREES WITH THE PIN, and this is the port of two tests in the
# deleted `pins.test.ts` — "the Dockerfile builds on that toolchain" and "compose
# passes the pin through rather than repeating it".
#
# WHY IT IS HERE AND NOT IN prime-go's header as a note. `pinned_go` above is
# checked against go.mod, which is the copy the COMPILER enforces. These two
# files are not read by the compiler and were read by nothing else: `grep -n
# GO_VERSION` across the repository returned one hit, `docker-compose.yml:151`,
# which is the thing being asserted rather than an assertion of it. So before this
# block, mise.toml's comment — "`Dockerfile`'s ARG GO_VERSION is 1.26, the tag the
# image builds with, the same way RUST_VERSION used to name an image rather than
# a patch" — was a claim about two files that nothing could check. It is now
# checked.
#
# THE RULE IS A PREFIX AND NOT EQUALITY, and that is the comment above being
# right: the image names a tag (`1.26`) while the pin names a release (`1.26.1`).
# Equal numbers would be a coincidence rather than a contract — a patch bump must
# not have to edit two files in two languages. What must hold is that the image's
# toolchain is the same major.minor the pin names, because a 1.25 image against a
# 1.26.1 pin builds a binary CI never tested and reads the difference as a defect
# in the code.
image_go="$(sed -n 's/^ARG GO_VERSION=\(.*\)/\1/p' Dockerfile)"
# `grep -E` and `tr -d` rather than a `sed` capture, and that is measured rather
# than stylistic: the sed spelling
#   s/^[[:space:]]*GO_VERSION:[[:space:]]*\([0-9][0-9.]*\).*/\1/p
# matches nothing on the macOS BSD sed — the same line `grep -nE
# '^[[:space:]]*GO_VERSION:'` finds at docker-compose.yml:151 — while exiting 0,
# which is the worst of both. A check that reads an empty string here would have
# reported "compose names no GO_VERSION" rather than "compose names 1.26", and a
# reader would have gone looking in the wrong file. Digits only, so the YAML
# quoting does not have to be modelled.
compose_go="$(grep -E '^[[:space:]]*GO_VERSION:' docker-compose.yml | head -n1 | tr -dc '0-9.')"
expected_prefix="${pinned_go%.*}"
for pair in "Dockerfile:$image_go" "docker-compose.yml:$compose_go"; do
  file="${pair%%:*}"
  found="${pair#*:}"
  if [ -z "$found" ]; then
    echo "bin/prime-go: $file names no GO_VERSION, and an image that does not say" >&2
    echo "  which toolchain it builds with is an image whose toolchain is a default." >&2
    exit 1
  fi
  if [ "$found" != "$expected_prefix" ]; then
    echo "bin/prime-go: mise.toml pins go $pinned_go and $file builds with $found." >&2
    echo "  One toolchain, three files (mise.toml, go.mod, the image tag) plus the" >&2
    echo "  compose variable that names it. The image tag is the major.minor prefix of" >&2
    echo "  the pin, so a patch bump needs no edit here — but a minor bump needs this" >&2
    echo "  one, and skipping it builds a binary CI never tested." >&2
    exit 1
  fi
done
echo "image tag: Dockerfile and docker-compose.yml build on go $expected_prefix, the major.minor mise.toml pins as $pinned_go"

step "gofmt -l"
# `-l` prints the files that NEED formatting and exits 0 either way, so the count
# is the assertion. An empty list is the pass and a non-empty one is a red that
# names the file.
#
# `./cmd ./internal` and not `./...`, for the reason pantry's does the same: the
# generated file is not this repository's to format, and a generator release that
# changes its own indentation would otherwise turn every run red over a file
# nobody is allowed to edit by hand.
unformatted="$(gofmt -l ./cmd ./internal)"
if [ -n "$unformatted" ]; then
  echo "bin/prime-go: these files are not gofmt-clean:" >&2
  echo "$unformatted" | sed 's/^/  /' >&2
  exit 1
fi
echo "every file under ./cmd and ./internal is gofmt-clean"

step "go build ./..."
go build ./...

step "go vet ./..."
go vet ./...

step "go test ./..."
# `-v`, AND THE OUTPUT IS FILTERED, and both halves are load-bearing.
#
# -count=1 defeats the test cache: a gate that can report a stale green is a gate
# that reports what it ran last, not what it would report now.
#
# `go test` DISCARDS a passing package's output entirely, so a package that prints
# its own `skip:` row prints it into a void on every green run — which is
# precisely the silent pass this repository has been bitten by before on the
# TypeScript side (`rateLimitRedisLive.test.ts`). It was measured there rather
# than assumed; it is true here for the same reason, and the equivalence tier's
# skip is the one that needs it.
out="$(go test -count=1 -v ./... 2>&1)" || {
  echo "$out"
  echo "bin/prime-go: go test failed; the full -v output is above." >&2
  exit 1
}
echo "$out" | grep -E '^(ok|FAIL|---|\?)|equivalence:' || true

# THE EQUIVALENCE BLOCK IS GONE, AND THE REASON IS A DELETION RATHER THAN A
# REWRITE.
#
# This block used to require one of two lines to appear in `go test`'s output:
# `equivalence: DID NOT RUN — …` (no bun to stand the TypeScript reference up) or
# `equivalence: N cases x M scenarios = K comparisons` (it ran). A missing
# summary line was a FAILURE rather than a zero, deliberately: the line was the
# evidence the tier had run, and `go test` discards a passing package's output,
# which is how `rateLimitRedisLive.test.ts` was once skipped in silence.
#
# AT CUTOVER (f87c891) THERE IS NO EQUIVALENCE TIER TO COUNT. `internal/equivalence`
# used to spawn `test/equivalence/reference.ts` and compare answers byte for byte;
# that harness retired with the TypeScript tree, and what is left in the package
# is the Go side asked directly (`caseSpec`, `ask`, `askBurst`) — the limiter's
# refusal, its announced remaining and its fail-open answer, plus
# `TestTheGoSideCountsRoutedTraffic`, the tripwire for the defect the comparison
# found. It runs unconditionally, prints neither of the two markers, and cannot
# skip.
#
# So the block was REMOVED rather than relaxed. The alternative — keep the grep
# and let it match nothing — is the worst of the three options: the failure it
# produced was a red gate naming a missing summary line that no code emits any
# more, and `bin/prime` was red on a clean master for exactly that reason. It was
# measured before this comment was written: exit 1, "internal/equivalence
# printed neither its summary nor a counted skip".
#
# WHAT THE BLOCK WAS WORTH, and what replaced it, so the removal is not read as
# a weakening. It counted one tier's skips. The tier that still CAN skip is the
# live Redis one, and the block immediately below counts that — same mechanism,
# same three outcomes, same escalation on `*_REQUIRED=1`. And the equivalence
# package's own tests are no longer exempt from anything: they are in
# `go test -count=1 -v ./...` like every other package and their `--- PASS:`
# lines are in the `suite:` count printed at the end of this script. What no
# longer exists is the ability to say "the TypeScript side agreed", because the
# TypeScript side no longer exists to agree or disagree.

# # THE SAME COUNT, FOR THE OTHER TIER THAT CAN SKIP
#
# `internal/ratelimit` has a live tier — the GCRA script against a real
# `redis-server` — and it skips for the same reason and in the same silence. This
# block exists because `live_test.go` says so in its own header: "the skip PRINTS a
# line beginning `ratelimit: DID NOT RUN` and `bin/prime-go` counts it". Until this
# block existed that sentence described a mechanism the gate did not have, which is
# the same defect as a comment asserting a property the code does not have.
#
# IT WAS NOT ONLY A MISSING COUNT. While running the tier against a real server
# (one was already listening on this machine at :6379) it turned out that
# `TestMain` exited 0 BEFORE `m.Run()` whenever `GATEWAY_REDIS_URL` was unset — so
# the entire package ran no tests at all, the parity table and the instant grid
# included, and `go test` printed `ok`. That is the worst shape this class of bug
# takes: a green about nothing whatsoever. The tier skips per test now and prints
# one line, and this block is what makes that line countable.
#
# SAME THREE OUTCOMES AS THE BLOCK ABOVE, for the same three reasons. RAN when the
# marker is absent. DID NOT RUN, and a failure, when the tier was declared
# required. Neither — which cannot be told apart here, because the live tier has no
# summary line to prove it ran — so the marker being ABSENT is taken as RAN and the
# `-v` run above is what would notice if this gate had stopped seeing its output.
ratelimit_skipped="$(grep -m1 -o 'ratelimit: DID NOT RUN.*' <<<"$out" || true)"
if [ -z "$ratelimit_skipped" ]; then
  echo "ratelimit: the live Redis tier RAN — no DID NOT RUN marker"
else
  echo "ratelimit: DID NOT RUN — $ratelimit_skipped"
  if [ "${GATEWAY_REDIS_REQUIRED:-0}" = "1" ]; then
    echo "bin/prime-go: GATEWAY_REDIS_REQUIRED=1 and the live Redis tier did not run." >&2
    exit 3
  fi
fi

# THE SKIP CEILING, and this block is the port of `test/noSkips.test.ts` rather
# than a replacement for it.
#
# That file read the suite's own source and failed on any `skip` outside a
# one-entry allowlist. Its premise is still true and still load-bearing: exactly
# one tier in this repository may skip, and it is named — the live Redis tier,
# gated on `GATEWAY_REDIS_URL`. So the check moved here rather than being deleted
# along with the file, and it is a real check on both sides:
#
#   * A RUNTIME COUNT. `go test -count=1 -v` above prints one `--- SKIP:` line per
#     skipped test, and `go test` discards a passing package's output — so this
#     block is the only place the number is ever visible. On a machine without
#     Redis the live tier skips 13 tests and that is the whole of it; with Redis
#     it skips 0.
#   * A SOURCE COUNT. The same property the TypeScript version read out of the
#     sources, checked where a converted skip would be WRITTEN rather than only
#     where it would be observed. A `t.Skip` behind an environment condition that
#     happens not to fire still lands here, which is the case a runtime count
#     cannot see.
#
# WHY A CEILING AND NOT A FLOOR, which is the one place this is weaker than the
# file it ports. `noSkips.test.ts` asserted EQUALITY with an allowlist; this
# cannot, because the legitimate count is 13 without Redis and 0 with it, and a
# gate that is right in one environment and red in the other is a gate people
# learn to disable. 13 is the no-Redis number, which is what `bin/prime` always
# produces, and a run with Redis sits BELOW the ceiling rather than over it — so
# the ceiling is the one direction that holds in both environments.
#
# What it therefore does NOT catch is the whole tier disappearing: a
# `GATEWAY_REDIS_URL` branch deleted whole leaves 0 skips, which is under the
# ceiling. `GATEWAY_REDIS_REQUIRED=1` is what catches that, and so is the `redis`
# CI job, which forces the tier. This block catches the other three of the four
# ways — an undeclared skip added, an allowlist entry outliving its skip, a
# second gated tier arriving — and the fourth is named rather than implied.
skip_count="$(grep -c '^--- SKIP: ' <<<"$out" || true)"
skip_ceiling=13
if [ "$skip_count" -gt "$skip_ceiling" ]; then
  echo "bin/prime-go: ${skip_count} tests skipped and this repository declares" >&2
  echo "  ${skip_ceiling} — the live Redis tier, and nothing else. Every skipped test is" >&2
  echo "  named below, because a gate that reports a count without naming the offender" >&2
  echo "  is a gate whose reader has to go and diff a file list by hand:" >&2
  grep -E '^--- SKIP: ' <<<"$out" | sed 's/^/    /' >&2
  exit 1
fi

# The source half. ONE call site is the whole allowance, and it is named rather
# than counted: an allowlist that only held a number would pass a repository
# where the declared skip moved to a different file, which is the stale-allowlist
# failure `noSkips.test.ts` had a test for by name.
skip_sites="$(grep -rn 't\.Skip(' ./cmd ./internal --include='*_test.go' || true)"
skip_site_count="$(printf '%s' "$skip_sites" | grep -c 't\.Skip(' || true)"
if [ "$skip_site_count" -ne 1 ] || ! printf '%s' "$skip_sites" | grep -q '^\./internal/ratelimit/live_test\.go:'; then
  echo "bin/prime-go: the tree has ${skip_site_count} t.Skip() call site(s) and this" >&2
  echo "  repository allows exactly one — internal/ratelimit/live_test.go, the live" >&2
  echo "  Redis tier. A second one is a second gated tier, and a gated tier nobody" >&2
  echo "  named is a tier whose skip nobody counts. What is there now:" >&2
  printf '%s\n' "$skip_sites" | sed 's/^/    /' >&2
  exit 1
fi
echo "skips: ${skip_count} of ${skip_ceiling} declared (all of them the live Redis tier), and 1 t.Skip() call site"

step "the generated server matches the OpenAPI document"
# REGENERATE AND DIFF, and this replaced a grep — which is the whole reason this
# step exists as a rewrite rather than an addition.
#
# WHAT IT USED TO DO, and why it was a hole rather than a check. A header grep —
#
#     grep -q '^// Code generated by … version v2\.8\.0 DO NOT EDIT\.$' "$gen"
#
# is true of every file the generator has EVER written, including one written from
# an older document. An `api.gen.go` that had drifted from `openapi/v1.yaml` by
# three operations would pass that step, and the failure would not even be silent
# for long: the Go router is generated, so a stale file answers the OLD routes
# with the NEW contract's promises.
#
# THE MEASUREMENT THAT MAKES THE REWRITE POSSIBLE, and it is the reason this is a
# gate rather than a note: `oapi-codegen` runs offline from the module cache on
# this machine.
#
#     $ GOFLAGS=-mod=mod GOPROXY="file://$(go env GOMODCACHE)/cache/download" \
#         go generate ./internal/api/
#
# Plain `GOPROXY=off` does NOT work — `go run <module>@<version>` still asks the
# proxy for the module's deprecation notice and fails with "module lookup disabled
# by GOPROXY=off" — so the file:// proxy is not a stylistic choice, it is the
# only offline spelling that resolves.
#
# AND THE GATE DOES NOT SKIP WHEN IT CANNOT RUN. There is no `|| true`, no
# conditional that returns green without the generator, and no "warn and
# continue": `set -euo pipefail` is already in force, so a missing generator, an
# empty cache or a network-dependent `go run` all fail this step. A gate that
# cannot run is not a gate that passed.
gen="internal/api/api.gen.go"
if [ ! -f "$gen" ]; then
  echo "bin/prime-go: $gen is missing. Run 'go generate ./internal/api/'." >&2
  exit 1
fi

# The checksum BEFORE regeneration, so this step can say whether it had to repair
# the working tree. Regenerating is destructive by construction — it overwrites
# whatever was there — and a step that silently rewrites a file a reader did not
# know it was rewriting is a step that surprises whoever is holding the
# repository. Reporting it costs one `cksum` and turns a surprise into a line.
gen_before="$(cksum < "$gen")"

module_cache="$(go env GOMODCACHE)"
# `regen_out` AND NOT `out`, and that is a correction rather than a style. The
# variable holding `go test`'s output is named `out` twenty lines above, so
# regenerating into it would overwrite the test results and this script would
# print a suite count of zero and exit ZERO.
#
# Caught by reading the gate's own output rather than its exit status, which is
# the standing rule in the worker contract applied to this repository's own
# script. A variable name is not a cosmetic choice in a script that reports its
# own coverage.
if ! regen_out="$(GOFLAGS=-mod=mod GOPROXY="file://$module_cache/cache/download" GOSUMDB=off \
  go generate ./internal/api/ 2>&1)"; then
  echo "bin/prime-go: regeneration FAILED, so whether $gen matches" >&2
  echo "  openapi/v1.yaml is unknown. A generator that cannot run is not a gate that" >&2
  echo "  passed, and this step deliberately fails rather than warning:" >&2
  echo "$regen_out" | sed 's/^/    /' >&2
  echo >&2
  echo "  If this machine has no oapi-codegen v2.8.0 in its module cache, fetch it once" >&2
  echo "  with a network and re-run: go mod download github.com/oapi-codegen/oapi-codegen/v2" >&2
  exit 1
fi
echo "$regen_out" | sed 's/^/  /'

# The header assertion is KEPT as well as the diff, and it is not redundant: it
# names the generator version the committed file came from, which a diff against a
# freshly-generated file would not tell you — a diff proves the two agree, not
# which generator produced either.
grep -q '^// Code generated by github.com/oapi-codegen/oapi-codegen/v2 version v2\.8\.0 DO NOT EDIT\.$' "$gen" || {
  echo "bin/prime-go: $gen does not carry the oapi-codegen v2.8.0 header. The" >&2
  echo "  generator is pinned on internal/api/generate.go's //go:generate line; if" >&2
  echo "  that pin moved, say so in the same commit as the regenerated file." >&2
  exit 1
}

# The post-processing step's own claim, checked rather than trusted. It rewrites
# the registrations so core's account-scope checker can read them, and it says it
# refuses when it has nothing to rewrite — so the thing worth asserting is that
# the committed file carries the result.
grep -q '^// POST-PROCESSED BY internal/api/stripbaseurl' "$gen" || {
  echo "bin/prime-go: $gen does not carry the stripbaseurl header, so the route" >&2
  echo "  registrations are still spelled r.Get(options.BaseURL+…) and core's" >&2
  echo "  account-scope checker cannot read them. Run 'go generate ./internal/api/'." >&2
  exit 1
}
#   OR ONE REGISTRATION WHOSE PATH IS AN EXPRESSION RATHER THAN A LITERAL.
# The pattern is the SHAPE, not the token, and that is a correction: the first
# draft grepped for `options.BaseURL+` anywhere in the file, and the header comment
# stripbaseurl prepends quotes the generator's own output in order to explain
# itself — so the gate went red on its own documentation. A check that fires on the
# text describing the thing it checks is a check whose red means nothing.
#
# `^\s*r\.<method>\(\s*[^"]` is core's recogniser's requirement read as a pattern:
# a `/`-prefixed string literal must be the FIRST term after the open paren. Any
# registration line that does not satisfy it is invisible to
# `account-scope-check`, and this repository's whole surface would read as
# `route_defs=0` — a count of nothing printing exactly like a count of zero.
if grep -qE '^[[:space:]]*r\.(Get|Post|Put|Patch|Delete|Head)\([[:space:]]*[^"]' "$gen"; then
  echo "bin/prime-go: $gen has a route registration whose path is an expression" >&2
  echo "  rather than a string literal, so core's account-scope checker cannot read" >&2
  echo "  it and this repository's surface reads as route_defs=0. Run" >&2
  echo "  'go generate ./internal/api/' — stripbaseurl removes the token." >&2
  exit 1
fi

# `git status --porcelain` rather than `git diff --quiet` because the gate must
# also catch a file that is UNTRACKED-but-present, and because `git diff` alone
# reports nothing for a tree with no HEAD (a fresh clone's first run).
drift="$(git status --porcelain -- "$gen" | sed 's/^/    /')"
if [ -n "$drift" ]; then
  echo "bin/prime-go: $gen DOES NOT MATCH openapi/v1.yaml. Regenerating changed it:" >&2
  echo "$drift" >&2
  echo >&2
  echo "  Run 'go generate ./internal/api/' and commit the result WITH the document" >&2
  echo "  change, in the same commit. generate.go says so: \"regeneration is only" >&2
  echo "  correct immediately after the document changes, in the same commit\" — and" >&2
  echo "  this step is what enforces it rather than trusting it." >&2
  exit 1
fi
gen_after="$(cksum < "$gen")"
if [ "$gen_before" != "$gen_after" ]; then
  echo "$gen WAS NOT WHAT openapi/v1.yaml PRODUCES, and this step has overwritten it."
  echo "  The committed state is correct — regenerate-and-diff could not have reached"
  echo "  this line otherwise — but the working tree had a hand edit, a stale"
  echo "  regeneration or a generator-version difference in it. Review what is there"
  echo "  now before committing:  git diff -- $gen"
  echo
fi
echo "$gen regenerates byte-identically from openapi/v1.yaml, carries the v2.8.0 header, and its registrations are readable"

# THE COUNTED SUITE, and it is printed here rather than left to be read out of
# `go test`'s own per-package lines. Two counts, because one of them cannot catch
# the failure the other cannot:
#
#   `suite:`    `--- PASS:` lines — moves when ANY test is lost, in any package.
#   `packages:` `ok ` lines — moves when a package stops compiling into the suite.
#
# Without `-v` this count would be zero on a wholly green gate, which is a floor
# that never fires and reads as the strongest kind of proof. The count is of PASS
# lines and not of tests that did not fail: a red gate still prints every passing
# test in the failing packages, so a red run's number is high by design — read it
# WITH this script's exit status and the `--- FAIL:` lines above.
suite_passed="$(printf '%s\n' "$out" | grep -c '^--- PASS: ' || true)"
suite_failed="$(printf '%s\n' "$out" | grep -c '^--- FAIL: ' || true)"
suite_packages="$(printf '%s\n' "$out" | grep -c '^ok  ' || true)"
echo
echo "suite: ${suite_passed} passed, ${suite_failed} failed"
echo "packages: ${suite_packages} with tests"

# TWO LINES, NOT ONE, and that is a decision rather than an oversight: a `proof`
# in gate.yml may capture exactly ONE group, because `minimum` reads the last one
# and a second group would make the floor mean whichever number happened to come
# second. `packages:` is printed for a reader and is NOT proved — a floor on it is
# worth almost nothing, because losing a package's tests is already caught by
# `suite` losing its tests, and losing a package from the suite without losing a
# test means the tests moved. An unused-looking number next to a proved one is
# still worth printing, and worth saying out loud that it is not proved.
#
# A NOTE ON THE FLOOR AND THIS PACKET'S SHAPE. `suite` moves when a test goes
# missing, which is what a floor is for, and it moves DOWN as well as up: the
# equivalence tier counts as one test whether it compared 72 things or none. That
# is why the equivalence tier prints its own comparison count on every green run
# — the floor says "something ran", and only the tier's own line says how much.
step "ok"